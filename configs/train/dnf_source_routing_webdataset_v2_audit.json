{
  "schema_version": "dnf_source_routing_webdataset_v2_audit",
  "status": "audit_only_not_training_ready",
  "formal_training_allowed": false,
  "definitions": {
    "clean_strict": "Speech with trusted clean-target provenance. It receives full-weight Eq.15 only.",
    "clean_candidate": "Speech whose provenance is plausible but whose clean-target status is unresolved. DNSMOS BAK is only a review stratum; approval requires independent evidence and frozen manual review.",
    "noisy_speech_target": "Usable speech without trusted clean-target status. It remains speech and receives Eq.13; it is never reinterpreted as noise-only.",
    "noise_only": "Speech-free, music-free, indoor-stable additive noise approved at item level after metadata, acoustic stationarity, and manual review.",
    "rir": "Indoor room impulse response for a future convolution operator only; never an additive Eq.13 noise component.",
    "exclude_invalid": "Undecodable or technically invalid content that is excluded rather than assigned to another semantic route."
  },
  "source_level_routes": {
    "clean_strict": [
      "EARS",
      "VCTK"
    ],
    "noisy_speech_target": [
      "CommonVoice25",
      "DNS5_LibriVox",
      "LibriTTS_augmented",
      "MLS_HQ_de_fr_es",
      "MLS_HQ_en",
      "NNCES",
      "SeniorTalk",
      "VocalSet"
    ]
  },
  "candidate_overlays": {
    "MLS_HQ_en": {
      "candidate_granularity": "shard_after_independent_holdout",
      "current_status": "audit_pending",
      "training_ready": false
    },
    "LibriTTS_augmented": {
      "candidate_granularity": "scored_item_only",
      "current_status": "audit_pending",
      "training_ready": false
    }
  },
  "indoor_noise_policy": {
    "source_level_noise_only_is_forbidden": true,
    "required_item_allowlist": "versioned_sha256_verified_manual_approval_artifact",
    "metadata_candidate_sources": [
      "DNS5_noise",
      "FSD50K"
    ],
    "primary_candidate_types": [
      "validated_continuous_fan",
      "mechanical_fan",
      "stable_hvac_or_air_conditioning_if_later_found",
      "stable_vehicle_cabin_hum_if_later_found"
    ],
    "excluded_from_primary": [
      "FMA",
      "WHAM_noise",
      "roadway",
      "car_passing_by",
      "revving",
      "race_car",
      "variable_engine_event",
      "speech",
      "music",
      "transient_event"
    ],
    "variable_vehicle_events_route": "audit_pending_secondary_ablation_only"
  },
  "rir_policy": {
    "candidate_sources": [
      "Arni",
      "DNS5_RIR_SLR26",
      "DNS5_RIR_SLR28"
    ],
    "current_status": "audit_pending",
    "training_ready": false,
    "primary_channel_policy": "mono_only",
    "operator": "convolution_before_additive_noise_pending_separate_contract"
  },
  "forbidden_transitions": [
    "low_confidence_speech_to_noise_only",
    "technical_hard_fail_to_noisy_speech_target",
    "dnsmos_score_only_to_clean_strict",
    "pending_noise_candidate_to_training_noise_only",
    "rir_to_additive_noise"
  ],
  "consumer_contract": {
    "existing_v1_loader_compatible": false,
    "phase_a_consumer": "none_phase_a_uses_frozen_EARS_VCTK_parameterized_noise_contract",
    "future_training_loader_must_require": [
      "training_ready_true",
      "approved_status",
      "artifact_sha256_match",
      "route_specific_schema_version"
    ]
  }
}
